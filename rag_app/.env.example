# ---- Groq LLM ----
GROQ_API_KEY=your_groq_api_key_here

# Groq deprecates models over time. Check https://console.groq.com/docs/models
# for the current list if this model stops working.
LLM_MODEL=openai/gpt-oss-120b

# ---- PostgreSQL ----
# Format: postgresql://<user>:<password>@<host>:<port>/<database>
# If you don't know your local Postgres username, it is usually "postgres".
DATABASE_URL=postgresql://postgres:admin@123@localhost:5432/RAG

# ---- Embeddings ----
# 384-dimensional local sentence-transformers model. No paid API needed.
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_DIMENSION=384

# ---- Enhanced Retrieval ----
TOP_K=5
SIMILARITY_THRESHOLD=0.65  # Lowered for better recall while maintaining precision

# ---- Response Mode Settings (Production Features) ----
ENABLE_GENERAL_RESPONSES=true   # Allow general AI responses when no relevant docs found
SHOW_RESPONSE_INDICATORS=true   # Show visual indicators for response types

# ---- Chunking ----
CHUNK_SIZE=700
CHUNK_OVERLAP=100

# ---- App ----
APP_HOST=localhost
APP_PORT=8000
